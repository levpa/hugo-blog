{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "hugo",
  "frontMatter.framework.startCommand": "make serve",
  "frontMatter.content.publicFolder": "blog/static",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.content.pageFolders": [
    {
      "title": "Pages",
      "path": "[[workspace]]/blog/content/page",
      "trailingSlash": true,
      "contentTypes": ["page"]
    },
    {
      "title": "Posts",
      "path": "[[workspace]]/blog/content/posts/{{year}}/{{month}}",
      "trailingSlash": true,
      "contentTypes": ["post"]
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "page",
      "pageBundle": true,
      "filePrefix": null,
      "slugTemplate": "{{title}}",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Slug",
          "name": "slug",
          "type": "string",
          "description": "URL-friendly version of the title"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Cover",
          "name": "cover",
          "type": "fields",
          "fields": [
            {
              "title": "Image",
              "name": "image",
              "type": "image"
            },
            {
              "title": "Alt text",
              "name": "alt",
              "type": "string"
            }
          ]
        },
        {
          "title": "Date",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Table of contents",
          "name": "toc",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "name": "post",
      "pageBundle": true,
      "filePrefix": null,
      "slugTemplate": "{{title}}",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Slug",
          "name": "slug",
          "type": "string",
          "description": "URL-friendly version of the title"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publish date",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Last modified",
          "name": "lastmod",
          "type": "datetime",
          "isModifiedDate": true
        },
        {
          "title": "Author",
          "name": "author",
          "type": "string",
          "default": "Lev Pasichnyi"
        },
        {
          "title": "Cover",
          "name": "cover",
          "type": "fields",
          "fields": [
            {
              "title": "Image",
              "name": "image",
              "type": "image"
            },
            {
              "title": "Alt text",
              "name": "alt",
              "type": "string"
            }
          ]
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Categories",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "Table of contents",
          "name": "toc",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "boolean",
          "default": false
        }
      ]
    }
  ]
}
